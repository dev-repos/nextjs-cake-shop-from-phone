# Copy to .env.local and fill in. Every payment path is a demo stub: no real money moves.

# Signs the order links and makes each order's own admin key, so the bakery's link opens that order only.
# Changing it invalidates every link already sent. Required in production; `npm run dev` falls back to a
# built-in dev-only secret. Generate one with: openssl rand -base64 32
ORDER_SECRET=

# Gmail account that sends the emails, and a 16-character App Password for it (Google Account > Security >
# 2-Step Verification > App passwords; needs 2-Step Verification on). Not your normal Gmail password.
# Leave either empty to write the emails to the server log instead of sending them.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# The bakery's inbox for new-order emails (each one links to that order's admin page). Defaults to GMAIL_USER.
ADMIN_EMAIL=

# UPI ID shown in the "Pay with a UPI app" button and QR code.
# Defaults to demo.only@invalid, which no UPI app can pay. Don't set a real ID on the demo site.
UPI_VPA=

# PayPal REST app credentials for the Invoicing API. The PayPal option is a stub that only logs
# the invoice it would create; it never calls PayPal, even when these are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
