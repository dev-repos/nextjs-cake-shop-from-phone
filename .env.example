# Copy to .env.local and fill in. Every payment path is a demo stub: no real money moves.

# Signs the order links (the bakery's admin link and the customer's confirmed-order link).
# Required in production; `npm run dev` falls back to a built-in dev-only secret.
# Generate one with: openssl rand -base64 32
ORDER_SECRET=

# Shared token the bakery types to open /admin/orders/<order number>. Leave empty to switch the admin page off.
# Demo-only login: one shared token, no user accounts.
ADMIN_TOKEN=

# UPI ID shown in the "Pay with a UPI app" button and QR code.
# Defaults to demo.only@invalid, which no UPI app can pay. Don't set a real ID on the demo site.
UPI_VPA=

# PayPal REST app credentials for the Invoicing API. The PayPal option is a stub that only logs
# the invoice it would create; it never calls PayPal, even when these are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
